# ==============================================================================
# Go Binaries & Compilations
# ==============================================================================
# Single binaries or standard build outputs
/*.exe
/*.exe-*
/*.dll
/*.so
/*.dylib
/*.test
/*.out

# Common binary outputs (adjust names to match your main executable/targets)
/bin/
/dist/
/main

# Profile / coverage test outputs
*.prof
*.cpu
*.mem
*.pprof
coverage.out
coverage.txt
cover.html

# ==============================================================================
# Go Dependencies
# ==============================================================================
# Ignore the vendor folder by default (Go modules handle reproducible builds via go.sum)
vendor/
node_modules

# ==============================================================================
# Environment Variables & Secrets
# ==============================================================================
.env
.env.*
!.env.example
.envrc*

# ==============================================================================
# IDEs & Code Editors
# ==============================================================================
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains / GoLand
.idea/
*.iws
*.iml
*.ipr

# Sublime Text / Vim / Emacs
*.sublime-project
*.sublime-workspace
.*.swp
.*.swo
*~

# ==============================================================================
# Operating System Files
# ==============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# Windows
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# ==============================================================================
# Tooling & General
# ==============================================================================
# Air (live reload for Go)
tmp/

# Delve debugger
__debug_bin*
