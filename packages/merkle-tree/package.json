{
  "name": "merkle-tree",
  "devDependencies": {
    "@rthings/config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsdown --out-dir ./dist",
    "dev": "npm run build -- --watch src",
    "lint": "oxlint --fix",
    "format": "oxfmt",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "type": "module",
  "dependencies": {
    "js-sha3": "^0.9.3"
  }
}
