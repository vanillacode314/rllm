{
  "name": "proto",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsdown --out-dir ./dist",
    "build:generate": "npm run proto:generate && tsdown --out-dir ./dist",
    "proto:generate": "buf generate",
    "dev": "npm run build:generate -- --watch src",
    "lint": "oxlint --fix",
    "format": "buf format --write"
  },
  "devDependencies": {
    "@rthings/config": "workspace:*",
    "@types/bun": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  },
  "dependencies": {
    "@bufbuild/buf": "^1.70.0",
    "@bufbuild/protobuf": "^2.12.0",
    "@bufbuild/protoc-gen-es": "^2.12.0"
  }
}
